<?xml version="1.0" encoding="UTF-8"?>
<!--
    The structure follows Vaadin's official Spring Boot archetype
    (com.vaadin:vaadin-archetype-spring-application:25.2.5). Two things where
    Vaadin 25 differs from earlier versions and which are easy to get wrong:

      - vaadin-dev is <optional>true</optional> so the dev tools do not leak
        onward as a transitive dependency
      - build-frontend runs in the main build. There is no separate production
        profile any more.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.0</version>
        <relativePath/>
    </parent>

    <groupId>fi.mstahv</groupId>
    <artifactId>sensor-hub</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <name>sensor-hub</name>
    <description>Receives temperature measurements from sensor devices over UDP</description>
    <packaging>jar</packaging>
    <url>https://github.com/mstahv/screwcloud</url>

    <licenses>
        <license>
            <name>GNU Affero General Public License v3.0</name>
            <url>https://www.gnu.org/licenses/agpl-3.0.txt</url>
        </license>
    </licenses>

    <properties>
        <java.version>21</java.version>
        <!-- Vaadin 25.2.5 pulls in Spring Boot 4.1.0, so the versions move as a pair. -->
        <vaadin.version>25.2.5</vaadin.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.vaadin</groupId>
                <artifactId>vaadin-bom</artifactId>
                <version>${vaadin.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!--
            The starter alone is enough: it brings the Apache-licensed core,
            which contains everything used here. com.vaadin:vaadin would add the
            commercial components, which are not needed.
        -->
        <dependency>
            <groupId>com.vaadin</groupId>
            <artifactId>vaadin-spring-boot-starter</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <!--
            PostgreSQL is the only database this application supports.

            H2 was here before and was a bad fit: a file database is one process
            wide, so it cannot be inspected with a client while the application
            runs, its file is easy to lose track of, and its SQL dialect is
            similar enough to PostgreSQL to hide problems but not the same. One
            real database in both development and production removes all of that.
        -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!--
            Schema versioning.

            Two separate traps here, both silent:

              - Spring Boot 4 split the auto-configurations into their own
                modules, so flyway-core alone gives the library but not
                FlywayAutoConfiguration, and the migrations never run. The
                starter brings both.
              - Flyway 10 moved database support out of the core into per-vendor
                modules. Without flyway-database-postgresql, startup fails with
                "Unsupported Database: PostgreSQL". H2 needed no such module,
                which is why this appears only now.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-flyway</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!--
            Web push notifications. Not part of the Vaadin starter, but its
            version comes from the Vaadin BOM. It brings the VAPID signing and
            the browser side subscription plumbing; the service worker that shows
            the notification is generated by @PWA, which is already enabled.
        -->
        <dependency>
            <groupId>com.vaadin</groupId>
            <artifactId>flow-webpush</artifactId>
        </dependency>

        <dependency>
            <groupId>in.virit</groupId>
            <artifactId>viritin</artifactId>
            <version>3.7.0</version>
        </dependency>

        <dependency>
            <groupId>in.virit</groupId>
            <artifactId>svg-visualizations</artifactId>
            <version>1.1.0</version>
        </dependency>

        <!-- Temperature gauge for the sensor cards' media slot. -->
        <dependency>
            <groupId>in.virit</groupId>
            <artifactId>gauge</artifactId>
            <version>1.0.0</version>
        </dependency>

        <!--
            Development-time helpers, not part of the production artifact.

            spring-boot-devtools is deliberately absent: Vaadin brings its own
            hot reload, so devtools only added a second restart mechanism and its
            restart classloader. It was never the cause of any data loss — its
            property defaults are registered with the lowest precedence, so
            application.properties always wins over them.
        -->
        <dependency>
            <groupId>com.vaadin</groupId>
            <artifactId>vaadin-dev</artifactId>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!--
            Spring Boot 4 split the test slices into their own artifacts, so
            @DataJpaTest no longer comes with starter-test. The package changed
            at the same time to
            org.springframework.boot.data.jpa.test.autoconfigure.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-data-jpa-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!--
            Browserless UI tests: drives the real views and components in the JVM,
            no browser and no frontend build. Comes from the Vaadin archetype, and
            the version comes from the platform BOM — do not pin it here.

            Apache 2 licensed, unlike TestBench's browser-driven part, so it needs
            no subscription.
        -->
        <dependency>
            <groupId>com.vaadin</groupId>
            <artifactId>browserless-test-spring</artifactId>
            <scope>test</scope>
        </dependency>

        <!--
            Testcontainers: a real PostgreSQL for both the tests and the local
            development run (see TestServer). Docker is therefore required to run
            the tests. That is a deliberate trade: the alternative is testing
            against a different database than the one in production.

            Note the artifact names. Testcontainers 2.0 renamed every module to
            testcontainers-*, so the org.testcontainers:postgresql that every
            older example shows has no 2.x release at all. Versions come from
            Spring Boot's BOM, which pins Testcontainers 2.0.5.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <defaultGoal>spring-boot:run</defaultGoal>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!--
                        Surefire runs with Java assertions enabled (-ea); at
                        runtime they are off.

                        Vaadin's BasicElementStateProvider.setAttribute contains
                        the assertion "attribute.equals(attribute.toLowerCase())",
                        which assumes HTML's lower-case attribute names. SVG
                        requires camelCase instead: SvgSparkLine sets the viewBox
                        and preserveAspectRatio attributes, so any test that
                        creates one fails with an AssertionError.

                        This does not affect how the application behaves, since
                        assertions are not enabled at runtime.
                    -->
                    <enableAssertions>false</enableAssertions>
                </configuration>
            </plugin>
            <plugin>
                <groupId>com.vaadin</groupId>
                <artifactId>vaadin-maven-plugin</artifactId>
                <version>${vaadin.version}</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>build-frontend</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
