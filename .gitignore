# Device-specific configuration: holds the WiFi password.
# Copy the matching config.h.example to config.h and edit that.
temperature-reader/config.h
esp32-s3-reader/config.h
pico-sleeper/config.h

# Arduino build output
temperature-reader/build/
esp32-s3-reader/build/
pico-sleeper/build/

.DS_Store

# A repository of its own, so that it can be published on its own. Ignored here
# rather than tracked as a submodule: a gitlink pointing at unpublished commits
# helps nobody.
#
# pi-reader does now build against it, so it has to be installed into the local
# Maven repository first — "mvn -f ../lr1121-java install". Until the artifact is
# published somewhere, a fresh clone of this repository cannot build pi-reader
# without also having that one.
lr1121-java/

# IDE
.idea/

# JVM crash logs
hs_err_pid*.log
replay_pid*.log

# The deployment target of one particular server. Left untracked so a public
# repository does not carry someone's host and account; delete this line if you
# want yours in version control.
vmhosting.conf
