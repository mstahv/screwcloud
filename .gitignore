# Device-specific configuration: holds the WiFi password.
# Copy the matching config.h.example to config.h and edit that.
temperature-reader/config.h
esp32-s3-reader/config.h
pico-sleeper/config.h

# Arduino build output
temperature-reader/build/
esp32-s3-reader/build/
pico-sleeper/build/

.DS_Store

# A repository of its own, so that it can be published on its own. Ignored here
# rather than tracked as a submodule: a gitlink pointing at unpublished commits
# helps nobody.
#
# Nothing builds against it any more — the LR11xx driver moved to pi4j-drivers, and
# pi-reader takes it from there. What is left here is pi4j-migration.md, which is
# the record of how that move went and what to feed back to the Pi4J project.
lr1121-java/

# The same, and now the one that matters: pi-reader takes its LoRa driver from
# pi4j-drivers, and until the LR11xx driver is released that means a local build of
# the pull request branch. README.md in pi-reader says how. Ignored rather than
# submoduled for the same reason as above, and tracked here rather than in
# .git/info/exclude because it is now a documented step somebody else may follow.
pi4j-drivers/

# IDE
.idea/

# JVM crash logs
hs_err_pid*.log
replay_pid*.log

# The deployment target of one particular server. Left untracked so a public
# repository does not carry someone's host and account; delete this line if you
# want yours in version control.
vmhosting.conf

# Full-resolution motif originals: re-downloadable, and 16 MB of them.
# See tools/motif-sources/README.md.
tools/motif-sources/*.jpg
tools/motif-sources/cropped/

# A working checkout of the Viritin add-on, its own git repository: the form
# API proposals in viritin-form-proposals.md are implemented and built there.
flow-viritin/

# The Gauge add-on checkout, likewise its own repository: the empty-value
# support the sensor cards lean on is built there.
gauge-addon/
