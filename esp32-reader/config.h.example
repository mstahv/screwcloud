#pragma once

/*
  TEMPLATE — copy this to config.h and edit that copy:

      cp config.h.example config.h

  config.h is git-ignored because it holds your WiFi password. This template is
  tracked, so keep placeholders here and real values only in your own copy.

  Only DEVICE_ID, WIFI_SSID and WIFI_PASSWORD need changing. Everything else has
  a working default, including the server address, which points at the public
  demo server.

  Nothing is wired to this board and nothing needs configuring away: a bare
  ESP32-S3 or ESP32-C3 with a RuuviTag or a Ruuvi Air in range is a complete
  setup. The same file serves both chips; the one line that differs between
  them picks itself by the target being compiled for, see RGB_LED_PIN.
*/

/*
   Device identifier, exactly 4 ASCII characters. Goes into the packet header and
   is shown as is in the server UI, so pick something readable. Give every device
   its own — including your Pico devices, if you run both.
*/
static const char DEVICE_ID[5] = "ABCD";

static const char WIFI_SSID[] = "your-network";
static const char WIFI_PASSWORD[] = "your-password";
// How long a connection is waited for at boot and on reconnect.
static const unsigned long WIFI_CONNECT_TIMEOUT_MS = 20000;

/*
   Receiving server.

   Defaults to the public demo server r.pakast.in. You are welcome to use it, but
   it comes with no guarantees: it may be down and the database may be wiped at
   any time. For data you care about, run your own server — see the README.

   Unlike the Pico firmware this may be a host name, since only WiFi is used and
   there is no AT-command DNS to worry about.
*/
static const char SERVER_HOST[] = "r.pakast.in";
static const uint16_t SERVER_PORT = 5555;

// Send interval, measured from one send to the next. Default 5 min.
static const unsigned long SEND_INTERVAL_MS = 5UL * 60UL * 1000UL;

// After a failed send, retry sooner than the normal interval.
static const unsigned long RETRY_INTERVAL_MS = 60000;

// How often the readings are printed to the serial console while listening.
static const unsigned long PRINT_INTERVAL_MS = 5000;

/* ==========================================================================
   Power

   An ESP32 with both radios busy runs hot: continuous BLE scanning and a held
   WiFi association are most of what the chip draws, and a device that reports
   every five minutes needs neither for more than a fraction of that. So the
   firmware works in cycles — listen, send, rest — and these decide the shape.
   ========================================================================== */

/*
   How long each cycle listens for advertisements before sending. A RuuviTag
   advertises every ~1.3 s and a Ruuvi Air more often, so twenty seconds hears
   every device in range many times over. This is also how long the first
   packet takes after power-on.

   The scan is fully on during the window and fully off outside it, which is
   what the saving is: at a five minute interval the receiver is on seven per
   cent of the time instead of all of it.
*/
#define LISTEN_MS 20000UL

/*
   CPU clock while running. The radios need at least 80; the default 240 buys
   nothing here but heat, since the work between two packets is parsing a few
   dozen bytes of advertisement and then waiting.
*/
#define CPU_FREQUENCY_MHZ 80

/*
   Deep sleep between cycles: the chip powers down after the send and a timer
   wakes it into a fresh boot for the next one. Cooler still, and the right
   choice for a device on a battery or in a closed box — but two things stop
   working while it sleeps. The light is dark between cycles (it blinks its
   status during the listening window and the send), and the USB serial console
   drops and reconnects every cycle, which makes watching the log a chore. Off
   by default for those two reasons; enable it once the device is proven and
   put away.

   Deep rather than light sleep on purpose: light sleep left the BLE controller
   in a state it did not recover from, and the device reported once and never
   again. A reboot per cycle costs a second and recovers everything.
*/
//#define SLEEP_BETWEEN_SENDS

/*
   Whether the light keeps blinking its status while the device rests between
   sends. Set to 0 and it blinks only while listening and around the send — the
   outcome is still shown every cycle, just not for the minutes in between,
   when it is telling an empty room.

   Honest numbers: at this brightness the LED costs a couple of milliamps on
   average, against twenty-odd for the chip awake at 80 MHz. It is a saving,
   and a small one; the large one is SLEEP_BETWEEN_SENDS above, which turns
   the light off between cycles anyway.
*/
#define STATUS_LED_WHILE_RESTING 1

/* ==========================================================================
   Ruuvi devices — tags and Airs alike
   ========================================================================== */

// How many distinct tags are kept in memory at once.
static const uint8_t MAX_RUUVI_TAGS = 8;

/*
   A tag broadcasts every ~1285 ms, so a reading older than this means the tag is
   out of range or its battery is dead. Stale readings are left out of the packet.
   A Ruuvi Air broadcasts more often still, so the same limit serves it.
*/
static const unsigned long RUUVI_STALE_MS = 60000;

/*
   Scan window and interval in milliseconds. Equal values mean effectively
   continuous scanning, which is what a tag broadcasting only every ~1285 ms
   needs — NimBLE's defaults would miss most advertisements.

   Note these are milliseconds. The Pico firmware passes BTstack raw 0.625 ms
   units for the same thing.
*/
static const uint16_t SCAN_INTERVAL_MS = 30;
static const uint16_t SCAN_WINDOW_MS = 30;

/* ==========================================================================
   The chip's own temperature sensor
   ========================================================================== */

/*
   Reported as its own sensor so it can be followed in the web UI like any other.
   It is not a room thermometer: the sensor is on the same die as the CPU and the
   radios, so it reads well above the air around it and moves with the load.
   Worth watching, not worth trusting.

   Comment it out to leave it out of the packet.
*/
#define ENABLE_INTERNAL_TEMPERATURE

/*
   The identifier the chip temperature is reported under. At most 3 characters,
   like every sensor id, and distinct from any RuuviTag label.
*/
#define INTERNAL_SENSOR_ID "CPU"

/* ==========================================================================
   Status LED

   The Waveshare Zero boards have no plain LED, only a WS2812 addressable RGB
   LED: on GPIO21 on the ESP32-S3-Zero, on GPIO10 on the ESP32-C3-Zero. The
   compiler says which chip it is building for, so the right one is picked
   here without a second config file. Check your own board if it differs.

   Brightness is kept low on purpose: a WS2812 at full output is unpleasantly
   bright indoors and wastes current for no benefit.
   ========================================================================== */
#if defined(CONFIG_IDF_TARGET_ESP32C3)
static const uint8_t RGB_LED_PIN = 10;
#else
static const uint8_t RGB_LED_PIN = 21;
#endif
static const uint8_t RGB_LED_BRIGHTNESS = 24;
